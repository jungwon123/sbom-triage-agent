# Copy to a file outside the repository, fill in, then:
#   kubectl -n sbom-triage create secret generic triage-secrets --from-env-file=<that file>
# Values here are placeholders. Never commit the filled-in file.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://triage:change-me@triage-postgres:5432/triage
# 32 characters or more. Needed when TRIAGE_AUTH=oidc; harmless otherwise.
TRIAGE_SESSION_SECRET=change-me-to-a-long-random-string-of-32-or-more
# Only what you use:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OIDC_CLIENT_SECRET=
# SLACK_WEBHOOK_URL=
