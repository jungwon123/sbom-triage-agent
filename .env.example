# Copy to .env and fill in. .env is git-ignored; never commit keys.
# Model that writes the verdict: anthropic | openai | local | replay | none (rule only)
LLM_PROVIDER=anthropic
# Default model (HANDOFF D34). Control depth with LLM_EFFORT. claude-fable-5-2 also works.
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=high
ANTHROPIC_API_KEY=

# Only when LLM_PROVIDER=openai (finals fallback). Set the model name the venue provides.
OPENAI_API_KEY=
OPENAI_MODEL=

# Two-stage mode (optional). Set to "local" so only the in-network model reads source code;
# LLM_PROVIDER then gets facts only (CVE id, package, scores, reachability) and no code.
LLM_CODE_PROVIDER=
# Local server with an OpenAI-compatible API (Ollama, vLLM, LM Studio)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=

# live | replay  (replay = no network, no Docker; reads fixtures/cache and recorded events)
DEMO_MODE=live

# Slack incoming webhook (or an in-house Slack-compatible webhook). The message has no source code.
SLACK_WEBHOOK_URL=

# Where records are kept: file (default, JSON under out/ and fixtures/cache) or postgres (HANDOFF D45).
# The offline demo and the tests use file. For postgres start deploy/docker-compose.yml first, then
# run: uv run python -m triage db init
TRIAGE_STORE=file
# DATABASE_URL=postgresql://triage:triage_dev@127.0.0.1:54329/triage
# Who runs queued jobs (sandbox passes started from the dashboard). Leave unset for the default:
# file store -> inline (a thread inside the API process), postgres -> external (a separate process,
# start it with: uv run python -m triage worker). One worker runs one job at a time.
# TRIAGE_WORKER=external
