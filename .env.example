# Copy to .env and fill in. .env is git-ignored; never commit keys.
# LLM provider: anthropic | openai | replay | none (rule only)
LLM_PROVIDER=anthropic
# Default model (HANDOFF D34). Fable 5.2 always thinks; control depth with LLM_EFFORT.
LLM_MODEL=claude-fable-5-2
# low | medium | high | xhigh | max
LLM_EFFORT=high
ANTHROPIC_API_KEY=

# Only when LLM_PROVIDER=openai (finals fallback). Set the model name the venue provides.
OPENAI_API_KEY=
OPENAI_MODEL=

# live | replay  (replay = no network, no Docker; reads fixtures/cache and recorded events)
DEMO_MODE=live
